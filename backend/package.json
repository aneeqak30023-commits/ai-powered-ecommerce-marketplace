{
  "name": "nexmart-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node src/index.js",
    "start": "node src/index.js",
    "test": "node --test --test-concurrency=1 src/tests/*.js",
    "prisma:generate": "prisma generate",
    "prisma:generate:production": "prisma generate --schema=prisma/schema.production.prisma",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "node src/scripts/seed-production.js",
    "seed:dev": "node src/scripts/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "@sfpy/node-core": "^0.3.5",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.5.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "prisma": "^6.8.2"
  }
}
